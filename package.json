{
  "name": "hbc-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test lib/*.test.mjs lib/giveaway/*.test.mjs",
    "check:index": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-content-index.mjs",
    "check:chat": "node scripts/chat-checklist.mjs",
    "check:layout": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-layout.mjs",
    "check:answers": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/answer-audit.mjs",
    "check:cwv": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-cwv.mjs",
    "check:fonts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-font-swap.mjs",
    "check:links": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-links.mjs",
    "check:contact": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-contact.mjs",
    "fetch:posters": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/fetch-video-posters.mjs",
    "check:schema": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-schema.mjs",
    "check:redirects": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-redirects.mjs",
    "preview:emails": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/render-email-previews.mjs",
    "build:email-thumb": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-email-thumbnail.mjs",
    "check:giveaway": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/check-giveaway.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@supabase/supabase-js": "^2.110.3",
    "next": "15.5.20",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
