.DS_Store
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# camera-roll originals dropped into public/images. Everything the site
# serves has a lowercase-hyphenated, keyword-descriptive filename — the name
# is an SEO surface — so a space or a camera prefix means the raw file got
# committed alongside the renamed one.
#
# Matching on a space and on the known prefixes, deliberately not on
# "contains an uppercase letter": core.ignorecase is true on macOS, which
# makes a [A-Z] class match lowercase too and would ignore the whole folder.
/public/images/* *
/public/images/IMG_*
/public/images/DSC*
/public/images/PXL_*
/public/images/Screenshot*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example
