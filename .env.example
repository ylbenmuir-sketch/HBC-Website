# Supabase — server-side only (used by app/api/consultation/route.ts).
# Find both in your Supabase project: Settings → API.
# The service-role key bypasses RLS — never expose it to the browser
# (no NEXT_PUBLIC_ prefix) and never commit .env.local.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical site URL — used for metadata, sitemap.xml, robots.txt, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.harmonizedbraincenters.com

# Lead notifications (lib/lead-notification.ts) — emails every consultation
# request to a human so a submitted form is actually seen.
#
# CURRENTLY OFF: no provider key has been issued yet. Until RESEND_API_KEY and
# LEADS_NOTIFY_EMAIL are both set, the API route logs a warning and continues —
# the Supabase row is saved either way, and a send failure never fails the form.
#
# To turn on: create a key at resend.com/api-keys, verify the sending domain,
# then set both. Server-side only — no NEXT_PUBLIC_ prefix.
# RESEND_API_KEY=re_your_api_key
# LEADS_NOTIFY_EMAIL=leads@harmonizedbraincenters.com

# Sender address for the notification above. Must be on a domain verified in
# Resend. Defaults to Resend's shared test sender (onboarding@resend.dev),
# which only delivers to the Resend account owner — fine for a wiring test,
# not for launch.
# LEADS_NOTIFY_FROM=Harmonized Website <leads@harmonizedbraincenters.com>

# Content verification (see CONTENT-CHECKLIST.md).
# Draft mode: unverified facts render with visible gold [CONFIRM] tags.
# Always on in `next dev`; set to "true" to preview drafts on a deployed build.
# NEXT_PUBLIC_SHOW_DRAFT_CONTENT=true

# Celebrity feature (Trisha Yearwood band). LAUNCH BLOCKER: enable only after
# written permission for name, likeness, image/video, quote, Grammy credit,
# and commercial website use is on file.
# NEXT_PUBLIC_FEATURE_CELEBRITY=true

# Launch builds: fail `next build` while any required fact is unverified.
# REQUIRE_VERIFIED_CONTENT=true
