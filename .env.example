# Supabase — server-side only (used by app/api/consultation/route.ts).
# Find both in your Supabase project: Settings → API.
# The service-role key bypasses RLS — never expose it to the browser
# (no NEXT_PUBLIC_ prefix) and never commit .env.local.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical site URL — used for canonical tags, og:url, sitemap.xml,
# robots.txt, and every JSON-LD `url`/`@id`.
#
# The apex is canonical: https://www.harmonizedbraincenterstn.com 301s to
# https://harmonizedbraincenterstn.com, so use the apex form here. No trailing
# slash — the value is concatenated with paths that already start with "/".
#
# NEXT_PUBLIC_* is inlined at build time, so the deploy environment needs its
# own copy AND a fresh build; nothing reads .env.example. Leaving it unset
# falls back to the apex value in lib/site-config.ts.
NEXT_PUBLIC_SITE_URL=https://harmonizedbraincenterstn.com

# Lead notifications (lib/lead-notification.ts) — emails each new lead to the
# clinic. While the platform is in testing, THIS is how a lead reaches a human.
#
# The email carries the whole lead: name, phone, email, who it's for, concerns,
# center, best time, and the visitor's note. Reply-to is set to the visitor's
# address when she gave one, so "Reply" in your mail client reaches her.
#
# Every lead is SAVED TO SUPABASE FIRST. Only then is the email sent; a send
# failure never fails the form (it is logged against the lead id and stamped
# on the row's notify_* columns). If the save fails, the visitor sees an error
# with the phone number, and the email still goes, marked as the only copy.
#
# Server-side only — no NEXT_PUBLIC_ prefix.
# RESEND_API_KEY=re_your_api_key

# ── Routing (lib/lead-routing.ts) ────────────────────────────────────────
# Each value is a comma-separated list: the FIRST address is the To, the rest
# are CC. First matching rule wins:
#   guide download                               → LEADS_GUIDE
#   "more information" (not ready to book)       → LEADS_MORE_INFO
#   ready to book, Concierge / at home           → LEADS_CONCIERGE
#   ready to book, Nashville                     → LEADS_NASHVILLE
#   ready to book, Murfreesboro                  → LEADS_MURFREESBORO
#   Franklin, "Not sure yet", no center, other   → LEADS_FALLBACK
# Chat assistant leads follow the same center rules as the form.
# A route left unset uses LEADS_FALLBACK; LEADS_FALLBACK unset uses
# LEADS_NOTIFY_EMAIL (the old single inbox). Each fallback logs a warning
# naming the missing variable, on every lead. Set LEADS_FALLBACK at minimum.
# Changing any of these in Vercel takes effect on the next deploy
# (Vercel → Deployments → Redeploy).
# LEADS_NASHVILLE=nashville-desk@example.com, manager@example.com
# LEADS_MURFREESBORO=boro-desk@example.com
# LEADS_CONCIERGE=concierge@example.com
# LEADS_MORE_INFO=info@example.com
# LEADS_GUIDE=marketing@example.com
# LEADS_FALLBACK=front-desk@example.com
# LEADS_NOTIFY_EMAIL=front-desk@example.com

# Sender for the notifications. Must be on harmonizedbraincenterstn.com (the
# domain verified in Resend); anything else — onboarding@resend.dev included —
# is ignored with a warning. Unset = leads@harmonizedbraincenterstn.com.
# LEADS_NOTIFY_FROM=Harmonized Brain Centers Website <leads@harmonizedbraincenterstn.com>
#
# None of this gates the guide. The lead magnet is a static file in
# public/guides/ and is downloaded on submit, so a visitor gets it with every
# variable above unset. Emailing her a copy is the thing that needs the
# verified domain — see README → "The guide, and how it actually reaches her".

# ── Confirmation text (lib/sms-confirmation.ts) ──────────────────────────
# Optional. After a consultation request lands, the visitor gets one text
# from the chosen center's Dialpad line: "we got your request, someone from
# our <Center> office will call you soon, call or text this number to talk
# sooner." Routed exactly like the email above — a center with no line set
# falls back to DIALPAD_SMS_FROM; "Not sure yet" and Concierge use the default.
#
# DIALPAD_API_KEY is a company API key (Dialpad Admin → My Company →
# Authentication → API Keys; company admins only). Numbers are E.164 and must
# be assigned to a user or group in Dialpad. Outbound texts to US numbers also
# need the company's A2P 10DLC registration approved in Dialpad, or carriers
# may drop them while the API still says OK. Unset = no text, nothing else
# changes. Server-side only — no NEXT_PUBLIC_ prefix.
# DIALPAD_API_KEY=
# DIALPAD_SMS_FROM=+16153318762
# DIALPAD_SMS_FROM_NASHVILLE=+1615XXXXXXX
# DIALPAD_SMS_FROM_MURFREESBORO=+1615XXXXXXX
# DIALPAD_SMS_FROM_FRANKLIN=+1615XXXXXXX

# ── Pick-a-time link (components/ContactForm.tsx) ────────────────────────
# Optional. A self-scheduling page — a Google Calendar appointment schedule
# works well and is free — shown as "Pick a time for your call" on the form's
# confirmation card. Unset = the button does not render. Read server-side on
# /contact, so changing it in Vercel needs a redeploy, not a rebuild.
# BOOKING_CALENDAR_URL=https://calendar.app.google/XXXXXXXX

# Content verification (see CONTENT-CHECKLIST.md).
# Draft mode: unverified facts render with visible gold [CONFIRM] tags.
# Always on in `next dev`; set to "true" to preview drafts on a deployed build.
# NEXT_PUBLIC_SHOW_DRAFT_CONTENT=true

# Celebrity feature — the Trisha Yearwood band that sits directly under the
# hero. This is the only thing that makes it render: components check
# FEATURE_CELEBRITY in lib/site-config.ts, which is true when this is "true"
# (or in draft mode, which is why the band always shows in `next dev`).
# Ben has directed that it ship on, so it is set rather than commented out.
#
# Setting it HERE DOES NOT ENABLE IT IN PRODUCTION. .env.example is a template
# — nothing reads it. NEXT_PUBLIC_* values are also inlined at build time, so
# the deploy environment needs its own copy AND a fresh build. See README →
# Deploying to Vercel.
#
# The permissions remain a precondition, and enabling the flag does not
# satisfy them: name, likeness, image/video, quote, Grammy credit, and
# commercial website use must each be confirmed in writing.
NEXT_PUBLIC_FEATURE_CELEBRITY=true

# Launch builds: fail `next build` while any required fact is unverified.
# REQUIRE_VERIFIED_CONTENT=true

# Measurement (lib/analytics.ts). All three unset = nothing loads, nothing
# renders, and the conversion events are no-ops. Set in the deploy environment
# AND rebuild — NEXT_PUBLIC_* is inlined at build time.
#
# GA4 measurement ID from the property's data stream (Admin → Data streams).
# Loads gtag.js after the page is interactive; page views are sent on every
# client-side navigation; the consultation form sends `generate_lead` and the
# guide form sends `sign_up`, both without any of what the visitor typed.
# Production only: nothing loads under `next dev` or on a Vercel preview.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
#
# Search Console → Settings → Ownership verification → HTML tag: the `content`
# value only, not the whole tag. Bing Webmaster Tools → the `msvalidate.01`
# content value. DNS verification works just as well and needs neither.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Site assistant (phase-8-chatbot.md). SHIPPING OFF.
# ---------------------------------------------------------------------------
# The widget renders and /api/chat answers anything other than 404 ONLY when
# NEXT_PUBLIC_FEATURE_ASSISTANT is "true". It is deliberately left unset here
# — unlike NEXT_PUBLIC_FEATURE_CELEBRITY, which is set because Ben directed it
# to ship on. Turn this on in one environment at a time, audit it, and only
# then consider production.
#
# Unlike the other feature flag it does NOT fall open in draft mode: `next dev`
# renders nothing either. A gate that opens whenever someone runs the site
# locally is not a gate.
#
# NEXT_PUBLIC_* is inlined at build time, so production needs the variable set
# AND a rebuild.
# NEXT_PUBLIC_FEATURE_ASSISTANT=true

# Model access for the assistant's answering layer (lib/chat/answer.ts).
# Server-side only — no NEXT_PUBLIC_ prefix, and the key is read in a route
# handler, never in a component. Without it the assistant falls back to its
# "I don't have that on the site" reply for every question.
# ANTHROPIC_API_KEY=sk-ant-...

# Conversation transcripts in the server log (lib/chat/logging.ts).
# Default is OFF, in code — what a visitor typed about her child does not sit
# in a server log with no retention policy. Every turn still logs its shape:
# timing, outcome, safety flags, grounding. Only the message text is dropped.
# Set to exactly "true" to turn transcripts on for a deliberate, bounded
# window — §8 asks Ben to read 20 real ones in the first week — then unset it.
# CHAT_LOG_TRANSCRIPTS=true

# ── Platform inquiry intake ───────────────────────────────────────────────
# The second destination for a contact-form submission (lib/inquiry-intake.ts).
# The row still saves to Supabase and the notification email still sends; this
# posts the same inquiry to the clinic platform, where it lands on the
# Follow-ups screen within ~30 seconds instead of waiting in an inbox. Both
# channels run in parallel for now — this is an addition, not a replacement.
#
# Wire contract: hbc-platform/context/reference/inquiry-intake-contract.md
#
# Both variables are SERVER-SIDE ONLY. Neither takes a NEXT_PUBLIC_ prefix:
# they are read in a route handler, and the browser posts to /api/consultation
# rather than to the platform, precisely so the secret never reaches a bundle.
#
# INQUIRY_INTAKE_SECRET is the shared secret, sent as the x-hbc-inquiry-secret
# header. Ben mints the value and sets the SAME value in both places — here (the
# website's Vercel env) and the platform API's env under the same name. It is
# never committed and never logged. If either variable is unset the route logs
# which one by name and skips the forward; the email path is unaffected.
#
# INQUIRY_API_BASE is the platform API origin, no trailing slash.
# Production: https://api.hbcstaff.com   ·   Local platform API: http://localhost:3001
# INQUIRY_API_BASE=https://api.hbcstaff.com
# INQUIRY_INTAKE_SECRET=

# ── 10-year giveaway (GIVEAWAY-PLAN.md; Phase 1, Oct 2026) ────────────────
# All SERVER-SIDE ONLY. See README → Environment variables.
#
# GIVEAWAY_ADMINS: who may sign in at /admin/10years. Comma-separated staff
# addresses, same format as the LEADS_* lists. Upserted into
# giveaway_admin_allowlist on every sign-in; no address lives in code.
# GIVEAWAY_ADMINS=ben@example.test, denise@example.test, kylie@example.test
#
# GIVEAWAY_TOKEN_SECRET: signs unsubscribe / verification / one-tap / claim
# links and the admin session cookie. Any long random string (16+ chars):
#   openssl rand -hex 32
# Changing it invalidates every link already sent.
# GIVEAWAY_TOKEN_SECRET=
#
# GIVEAWAY_ENV: optional. production | preview | local | test. Defaults from
# VERCEL_ENV. Every giveaway read and write is scoped to it, so a check run
# with GIVEAWAY_ENV=test can never touch a real entrant.
# GIVEAWAY_ENV=test
#
# GIVEAWAY_ALERTS / GIVEAWAY_ALERTS_OWNER (Phase 3): winner alerts, Tue–Fri
# to the first, Monday and Saturday to the second. First address To, rest CC.
# GIVEAWAY_ALERTS=
# GIVEAWAY_ALERTS_OWNER=
